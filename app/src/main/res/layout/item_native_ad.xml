<?xml version="1.0" encoding="utf-8"?>
<com.google.android.gms.ads.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:background="?attr/greyslider"
    android:layout_marginVertical="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="0dp">

        <!-- MediaView MUSS exakt 120x120 sein für Video-Support ohne Warnung -->
        <com.google.android.gms.ads.nativead.MediaView
            android:id="@+id/ad_media"
            android:layout_width="120dp"
            android:layout_height="120dp" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp">

            <TextView
                android:id="@+id/ad_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anzeige"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:background="@drawable/edit_text_rounded_corner"
                android:backgroundTint="@color/blue_500"
                android:paddingHorizontal="4dp"
                android:layout_alignParentTop="true" />

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ad_label"
                android:layout_marginTop="2dp"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="?attr/colorTextNormal"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/ad_headline"
                android:textSize="11sp"
                android:textColor="?attr/colorTextNormal"
                android:maxLines="2"
                android:ellipsize="end" />

            <Button
                android:id="@+id/ad_call_to_action"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_alignParentBottom="true"
                android:backgroundTint="@color/yellow"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:padding="0dp"
                android:textAllCaps="false" />
        </RelativeLayout>
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
